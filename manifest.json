{
  "manifest_version": 3,
  "name": "AI Commander",
  "version": "1.0",
  "description": "Control ChatGPT, Claude, Gemini & Grok from one dashboard",
  "permissions": ["tabs", "scripting", "storage", "activeTab", "clipboardWrite"],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://claude.ai/*",
    "https://gemini.google.com/*",
    "https://grok.com/*"
  ],
  "action": {
    "default_popup": "",
    "default_title": "AI Commander — Open Dashboard"
  },
  "background": {
    "service_worker": "background.js"
  },
  "chrome_url_overrides": {},
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://claude.ai/*",
        "https://gemini.google.com/*",
        "https://grok.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}